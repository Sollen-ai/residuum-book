#!/bin/sh
# Refuse a commit that breaks the book. Runs on this machine only: listings
# go through Residuum's launcher, which needs the local systemd session.
# Enable once per clone:  git config core.hooksPath build/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: tests" >&2
python3 -m pytest -q build/tests >&2
echo "pre-commit: spine" >&2
./book check-spine >&2
echo "pre-commit: draft build (re-runs changed listings)" >&2
./book build --draft >&2
